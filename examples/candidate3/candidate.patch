-      else                             r[i*8 +: 8] = base[i*8 +: 8];
-    end
-    mergev8 = r;
+    logic [63:0] lm;
+    logic [511:0] m;
+    // 8-bit-lane form of the same lane-mask merge (identical window semantics)
+    lm = ((64'd1 << wid) - 64'd1) << off;
+    for (int i = 0; i < 64; i++) m[i*8 +: 8] = {8{lm[i]}};
+    mergev8 = (base & ~m) | (src & m);
   endfunction
 
